{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "ledgerai": {
      "source": {
        "source": "github",
        "repo": "Vuththana/ledgerai-claude-plugin"
      }
    }
  },
  "enabledPlugins": {
    "sdd@ledgerai": true,
    "sdd-web@ledgerai": true,
    "sdd-spring@ledgerai": true,
    "sdd-fastapi@ledgerai": true
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git -C * status)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * submodule status *)",
      "Bash(python3 -I *sddtool.py *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm install *)",
      "Edit(**/docs/data-dictionary/**)",
      "Edit(**/build.gradle)",
      "Edit(**/settings.gradle)",
      "Edit(**/gradle/libs.versions.toml)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/pnpm-lock.yaml)"
    ]
  }
}
