{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "ledgerai": {
      "source": {
        "source": "github",
        "repo": "Vuththana/ledgerai-claude-plugin"
      }
    }
  },
  "enabledPlugins": {
    "ledgerai@ledgerai": true
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Edit(docs/data-dictionary/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
