{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "ledgerai": {
      "source": {
        "source": "github",
        "repo": "Vuththana/ledgerai-claude-plugin"
      }
    }
  },
  "enabledPlugins": {
    "ledgerai@ledgerai": true,
    "website-dev@ledgerai": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm build)",
      "Bash(pnpm dlx shadcn add *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm install *)",
      "Bash(git push *)",
      "Edit(docs/data-dictionary/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(pnpm-lock.yaml)"
    ]
  }
}
