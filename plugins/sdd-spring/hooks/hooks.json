{
  "description": "LedgerVision Spring Boot hooks",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-check.sh\"",
            "timeout": 300,
            "statusMessage": "Gradle compile check"
          }
        ]
      }
    ]
  }
}
