{
  "description": "LedgerVision team hooks",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/eslint-fix.sh\"",
            "timeout": 60,
            "statusMessage": "ESLint --fix"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/package-gate.py\"",
            "timeout": 20,
            "statusMessage": "Checking the package request sheet"
          }
        ]
      }
    ]
  }
}
